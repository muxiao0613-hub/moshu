{
  "name": "moshub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:mogao && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run",
    "build": "npm run build:mogao && npm run typecheck && vite build",
    "tauri": "node scripts/tauri.mjs",
    "release:local": "node scripts/release-local.mjs",
    "rust": "node scripts/rust.mjs",
    "build:mogao": "npm --prefix integrations/mogao run build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
